{
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "outDir": "dist",
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@features/*": ["backend/features/*"],
      "@platform/*": ["backend/platform/*"],
      "@schemas/*": ["backend/schemas/*"],
      "@lib/*": ["backend/lib/*"],
      "@utils/*": ["backend/utils/*"],
      "@validators/*": ["backend/validators/*"],
      "@shared/*": ["shared/*"],
      "@types/*": ["shared/types/*"],
      "@frontend/*": ["frontend/*"],
      "@features-frontend/*": ["frontend/features/*"],
      "@schemas-frontend/*": ["frontend/schemas/*"],
      "@shared-frontend/*": ["frontend/shared/*"],
      "@ui/*": ["frontend/shared/ui/ui/*"],
      "@hooks/*": ["frontend/hooks/*"],
      "@components/*": ["frontend/components/*"],
      "@styles/*": ["frontend/styles/*"],
      "@app/*": ["frontend/app/*"],
      "@docs/*": ["docs/*"],
      "@tests/*": ["tests/*"],
      "@scripts/*": ["scripts/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": [],
    "isolatedModules": true
  },
  "include": [
    "frontend/**/*",
    "backend/**/*",
    "shared/**/*",
    "tests/**/*",
    "docs/**/*",
    "scripts/**/*",
    "vite.config.ts",
    "postcss.config.ts",
    "tailwind.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
