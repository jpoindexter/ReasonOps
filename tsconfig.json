{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "outDir": "dist",
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@backend/*": ["backend/*"],
      "@backend/api/*": ["backend/api/*"],
      "@backend/config/*": ["backend/config/*"],
      "@backend/analytics/*": ["backend/analytics/*"],
      "@backend/events/*": ["backend/events/*"],
      "@backend/exporters/*": ["backend/exporters/*"],
      "@backend/jobs/*": ["backend/jobs/*"],
      "@backend/lib/*": ["backend/lib/*"],
      "@backend/lib/llm/*": ["backend/lib/llm/*"],
      "@backend/lib/parsing/*": ["backend/lib/parsing/*"],
      "@backend/lib/scoring/*": ["backend/lib/scoring/*"],
      "@backend/metrics/*": ["backend/lib/metrics/*"],
      "@backend/schemas/*": ["backend/schemas/*"],
      "@backend/services/*": ["backend/services/*"],
      "@frontend/*": ["frontend/*"],
      "@frontend/components/*": ["frontend/components/*"],
      "@frontend/components/layout/*": ["frontend/components/layout/*"],
      "@frontend/components/panels/*": ["frontend/components/panels/*"],
      "@frontend/components/ui": ["frontend/components/ui/index.ts"],
      "@frontend/components/ui/button": ["frontend/components/ui/button"],
      "@frontend/components/ui/input": ["frontend/components/ui/input"],
      "@frontend/components/ui/label": ["frontend/components/ui/label"],
      "@frontend/components/ui/slider": ["frontend/components/ui/slider"],
      "@frontend/components/ui/textarea": ["frontend/components/ui/textarea"],
      "@frontend/hooks/*": ["frontend/hooks/*"],
      "@frontend/lib/*": ["frontend/lib/*"],
      "@frontend/schemas/*": ["frontend/schemas/*"],
      "@frontend/types/*": ["frontend/types/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["@testing-library/jest-dom"]
  }
}
