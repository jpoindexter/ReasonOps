    "jsonl",
    "nextjs",
    "supabase"
  ],
  "author": "THEFT Studio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jpoindexter/ReasonOps"
  },
  "bugs": {
    "url": "https://github.com/jpoindexter/ReasonOps/issues"
  },
  "homepage": "https://github.com/jpoindexter/ReasonOps#readme",
  "packageManager": "pnpm@10.9.0",
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@supabase/supabase-js": "^2.49.4",
    "@testing-library/jest-dom": "^6.6.3",
